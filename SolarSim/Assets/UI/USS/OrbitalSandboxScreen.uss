/* ============================================================
   THEME VARIABLES
   Change these to switch the entire UI color scheme.
   Future: red (combat), orange (manual piloting), etc.
   ============================================================ */

:root {
    --ui-color-primary: rgb(40, 220, 80);
    --ui-color-primary-dim: rgb(25, 140, 50);
    --ui-color-primary-bright: rgb(80, 255, 120);

    --ui-bg-panel: rgba(2, 8, 4, 0.92);
    --ui-bg-panel-header: rgba(4, 16, 8, 0.95);
    --ui-bg-row-hover: rgba(40, 220, 80, 0.08);
    --ui-bg-button: rgba(8, 30, 12, 0.85);
    --ui-bg-button-hover: rgba(20, 60, 30, 0.95);
    --ui-bg-button-active: rgba(30, 100, 45, 0.95);
    --ui-bg-modal-overlay: rgba(0, 0, 0, 0.7);
    --ui-bg-modal: rgba(2, 10, 4, 0.96);

    --ui-border-color: rgba(40, 220, 80, 0.35);
    --ui-border-color-bright: rgba(40, 220, 80, 0.6);

    --ui-text-primary: rgb(40, 220, 80);
    --ui-text-dim: rgba(40, 220, 80, 0.55);
    --ui-text-bright: rgb(120, 255, 160);

    --ui-tab-inactive: rgba(40, 220, 80, 0.25);
    --ui-tab-active: rgba(40, 220, 80, 0.7);
}

/* ============================================================
   ROOT LAYOUT
   ============================================================ */

.root-container {
    flex-direction: row;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 4px;
}

/* ============================================================
   SIDE PANELS
   ============================================================ */

.side-panel {
    width: 260px;
    min-width: 200px;
    background-color: var(--ui-bg-panel);
    flex-shrink: 0;
    overflow: hidden;
    border-width: 1px;
    border-color: var(--ui-border-color);
    border-radius: 2px;
    flex-direction: column;
}

.left-panel {
    margin-right: 4px;
}

.right-panel {
    margin-left: 4px;
}

/* --- Panel header --- */

.panel-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: var(--ui-bg-panel-header);
    border-bottom-width: 1px;
    border-bottom-color: var(--ui-border-color);
    padding: 4px 8px;
    flex-shrink: 0;
    min-height: 28px;
}

.panel-title {
    font-size: 13px;
    color: var(--ui-text-primary);
    -unity-font-style: bold;
    letter-spacing: 2px;
    flex-grow: 1;
    margin: 0;
    padding: 0;
    border-bottom-width: 0;
}

.panel-collapse-btn {
    width: 24px;
    height: 24px;
    font-size: 14px;
    color: var(--ui-text-primary);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--ui-border-color);
    border-radius: 2px;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
}

.panel-collapse-btn:hover {
    background-color: var(--ui-bg-button-hover);
    border-color: var(--ui-border-color-bright);
}

/* --- Panel body --- */

.panel-body {
    flex-grow: 1;
    overflow: hidden;
    padding: 6px 8px;
}

/* ============================================================
   CENTER VIEWPORT
   ============================================================ */

.center-viewport {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
}

/* ============================================================
   OBJECT LIST (left panel)
   ============================================================ */

.object-list {
    flex-grow: 1;
}

/* --- List item with icon --- */

.list-item-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 4px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 2px;
    margin: 1px 0;
}

.list-item-row:hover {
    background-color: var(--ui-bg-row-hover);
    border-color: var(--ui-border-color);
}

.list-item-icon {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: var(--ui-text-dim);
    margin-right: 6px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.list-item-label {
    font-size: 13px;
    color: var(--ui-text-primary);
    -unity-text-align: middle-left;
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* ============================================================
   DETAILS PANEL (right panel)
   ============================================================ */

/* Large icon in the details panel (300x300 PNG) */
.details-icon {
    width: 64px;
    height: 64px;
    align-self: center;
    margin-top: 4px;
    margin-bottom: 6px;
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.details-content {
    flex-direction: column;
    flex-grow: 1;
}

.details-row {
    flex-direction: row;
    flex-shrink: 0;
    min-height: 22px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(40, 220, 80, 0.1);
}

.details-cell-label {
    flex-basis: 35%;
    flex-shrink: 0;
    flex-grow: 0;
    overflow: hidden;
    padding-right: 4px;
}

.details-cell-value {
    flex-basis: 65%;
    flex-shrink: 1;
    flex-grow: 1;
    overflow: hidden;
    padding-left: 4px;
}

.details-label {
    font-size: 11px;
    color: var(--ui-text-dim);
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.details-value {
    font-size: 11px;
    color: var(--ui-text-primary);
    -unity-text-align: middle-left;
    overflow: hidden;
    white-space: normal;
}

.no-selection-text {
    font-size: 12px;
    color: var(--ui-text-dim);
    -unity-text-align: upper-center;
    margin-top: 20px;
}

.details-more-btn {
    align-self: flex-end;
    min-width: 100px;
    height: 28px;
    margin-top: 8px;
    padding: 2px 12px;
    font-size: 12px;
    color: var(--ui-text-primary);
    background-color: var(--ui-bg-button);
    border-width: 1px;
    border-color: var(--ui-border-color);
    border-radius: 2px;
    -unity-text-align: middle-center;
}

.details-more-btn:hover {
    background-color: var(--ui-bg-button-hover);
    border-color: var(--ui-border-color-bright);
    color: var(--ui-text-bright);
}

/* ============================================================
   TIME CONTROLS
   ============================================================ */

.time-controls {
    flex-direction: row;
    align-items: center;
    align-self: center;
    background-color: var(--ui-bg-panel);
    border-radius: 2px;
    padding: 4px 8px;
    margin-bottom: 8px;
    border-width: 1px;
    border-color: var(--ui-border-color);
}

.time-btn {
    min-width: 60px;
    height: 26px;
    margin: 0 2px;
    padding: 2px 8px;
    font-size: 12px;
    color: var(--ui-text-primary);
    background-color: var(--ui-bg-button);
    border-radius: 2px;
    border-width: 1px;
    border-color: var(--ui-border-color);
    -unity-text-align: middle-center;
}

.time-btn:hover {
    background-color: var(--ui-bg-button-hover);
    border-color: var(--ui-border-color-bright);
}

.time-btn-active {
    background-color: var(--ui-bg-button-active);
    border-color: var(--ui-border-color-bright);
    color: var(--ui-text-bright);
}

.time-separator {
    width: 1px;
    height: 18px;
    background-color: var(--ui-border-color);
    margin: 0 4px;
}

.time-status {
    font-size: 12px;
    color: var(--ui-text-dim);
    margin-left: 6px;
    min-width: 50px;
    -unity-text-align: middle-center;
}

/* ============================================================
   SCROLLBAR THEMING
   ============================================================ */

.unity-scroller--vertical {
    width: 8px;
}

.unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(40, 220, 80, 0.06);
    border-width: 0;
}

.unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(40, 220, 80, 0.25);
    border-width: 1px;
    border-color: rgba(40, 220, 80, 0.35);
    border-radius: 2px;
    min-height: 20px;
}

.unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgba(40, 220, 80, 0.45);
    border-color: rgba(40, 220, 80, 0.65);
}

.unity-scroller--vertical .unity-repeat-button {
    display: none;
}

.unity-scroller--horizontal {
    height: 8px;
}

.unity-scroller--horizontal .unity-base-slider__tracker {
    background-color: rgba(40, 220, 80, 0.06);
    border-width: 0;
}

.unity-scroller--horizontal .unity-base-slider__dragger {
    background-color: rgba(40, 220, 80, 0.25);
    border-width: 1px;
    border-color: rgba(40, 220, 80, 0.35);
    border-radius: 2px;
}

.unity-scroller--horizontal .unity-repeat-button {
    display: none;
}

/* ============================================================
   MODAL OVERLAY + DETAIL WINDOW
   ============================================================ */

.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--ui-bg-modal-overlay);
    justify-content: center;
    align-items: center;
}

.modal-window {
    width: 600px;
    min-height: 400px;
    max-height: 80%;
    background-color: var(--ui-bg-modal);
    border-width: 1px;
    border-color: var(--ui-border-color-bright);
    border-radius: 2px;
    flex-direction: column;
    overflow: hidden;
}

/* --- Modal header --- */

.modal-header {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px 8px 14px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ui-border-color);
    flex-shrink: 0;
}

.modal-icon {
    width: 48px;
    height: 48px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.modal-header-text {
    flex-direction: column;
    flex-grow: 1;
}

.modal-title {
    font-size: 18px;
    color: var(--ui-text-bright);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.modal-subtitle {
    font-size: 12px;
    color: var(--ui-text-dim);
    margin-top: 2px;
}

.modal-close-btn {
    width: 28px;
    height: 28px;
    font-size: 16px;
    color: var(--ui-text-primary);
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--ui-border-color);
    border-radius: 2px;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
    flex-shrink: 0;
}

.modal-close-btn:hover {
    background-color: rgba(220, 40, 40, 0.3);
    border-color: rgb(220, 40, 40);
    color: rgb(255, 100, 100);
}

/* --- Modal tabs --- */

.modal-tabs {
    flex-direction: row;
    padding: 0 14px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ui-border-color);
    flex-shrink: 0;
}

.modal-tab {
    min-width: 80px;
    height: 30px;
    padding: 4px 12px;
    font-size: 12px;
    color: var(--ui-text-dim);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    -unity-text-align: middle-center;
    margin: 0;
}

.modal-tab:hover {
    color: var(--ui-text-primary);
    background-color: var(--ui-bg-row-hover);
}

.modal-tab-active {
    color: var(--ui-text-bright);
    border-bottom-color: var(--ui-text-primary);
}

/* --- Modal body --- */

.modal-body {
    flex-grow: 1;
    padding: 12px 14px;
}

.modal-tab-content {
    flex-grow: 1;
    flex-direction: column;
}

.modal-tab-content-hidden {
    display: none;
}

.modal-details-row {
    flex-direction: row;
    flex-shrink: 0;
    min-height: 22px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(40, 220, 80, 0.1);
}

.modal-section-header {
    font-size: 12px;
    color: var(--ui-text-dim);
    -unity-font-style: bold;
    margin-top: 10px;
    margin-bottom: 4px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ui-border-color);
    letter-spacing: 1px;
}

.modal-empty-text {
    font-size: 12px;
    color: var(--ui-text-dim);
    -unity-text-align: upper-center;
    margin-top: 30px;
}
